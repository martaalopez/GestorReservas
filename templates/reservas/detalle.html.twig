{% extends 'base.html.twig' %}

{% block titulo %}Detalle de la Reserva #{{ reserva.id }}{% endblock %}

{% block contenido %}
    <h2>Reserva de {{ reserva.nombre_huesped }}</h2>
    
    <ul>
        <li><strong>Email:</strong> {{ reserva.email_huesped }}</li>
        <li><strong>Alojamiento:</strong> {{ reserva.nombre_alojamiento }}</li>
        <li><strong>Fechas:</strong> {{ reserva.fecha_entrada|date('d/m/Y') }} al {{ reserva.fecha_salida|date('d/m/Y') }}</li>
        <li><strong>Importe:</strong> {{ reserva.importe|number_format(2, ',', '.') }} €</li>
        <li><strong>Estado:</strong> {{ reserva.estado }}</li>
    </ul>

    <h3>Historial (Timeline)</h3>
    <ul style="list-style: none; padding-left: 0;">
        {# Bucle para recorrer los eventos #}
        {% for evento in eventos %}
            <li style="margin-bottom: 10px; border-left: 3px solid #333; padding-left: 10px;">
                <strong>{{ evento.tipo }}</strong>: {{ evento.descripcion }}
                <br>
                <small style="color: gray;">{{ evento.fecha_creacion }}</small>
            </li>
        {% else %}
            <li>No hay eventos registrados.</li>
        {% endfor %}
    </ul>

    <a href="/vistas/reservas">&larr; Volver al listado</a>
{% endblock %}