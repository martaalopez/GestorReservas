{% extends 'base.html.twig' %}

{% block titulo %}Detalle de la reserva{% endblock %}

{% block contenido %}

    <h2>Reserva de {{ reserva.nombre_huesped }}</h2>

    <p>Email: {{ reserva.email_huesped }}</p>
    <p>Alojamiento: {{ reserva.nombre_alojamiento }}</p>
    <p>Entrada: {{ reserva.fecha_entrada }}</p>
    <p>Salida: {{ reserva.fecha_salida }}</p>
    <p>Importe: {{ reserva.importe }} €</p>
    <p>Estado: {{ reserva.estado }}</p>

    <h3>Historial</h3>

    {% for evento in eventos %}
        <p>{{ evento.tipo }}: {{ evento.descripcion }} ({{ evento.fecha_creacion }})</p>
    {% else %}
        <p>No hay eventos registrados.</p>
    {% endfor %}

    <a href="/vistas/reservas">Volver al listado</a>

{% endblock %}